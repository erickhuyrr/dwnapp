{
  "name": "media-downloader",
  "version": "1.0.0",
  "description": "Universal Media Downloader - Download videos & audio from 17+ platforms",
  "author": "Asmit Adk",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "dev": "npx cap sync && npx cap run android",
    "build": "echo 'No build step needed for static HTML'",
    "sync": "npx cap sync",
    "sync:android": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "copy": "npx cap copy",
    "update": "npx cap update",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "video-downloader",
    "media-downloader",
    "tiktok-downloader",
    "instagram-downloader",
    "youtube-downloader",
    "capacitor",
    "pwa",
    "mobile-app"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/media-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/media-downloader/issues"
  },
  "homepage": "https://github.com/yourusername/media-downloader#readme"
}
